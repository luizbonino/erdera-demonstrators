@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# The media type is wrong on purpose, as on the WP13 record: it says text/csv
# for a gzipped tab-separated file.

<{BASE}/hd_download.ttl>
    a dcat:Distribution ;
    dct:title "Downloadable distribution of the synthetic Huntington matrix" ;
    dcat:mediaType "text/csv" ;
    dcat:downloadURL <{BASE}/geo/download/?acc=GSE0&format=file&file=GSE0%255Fcounts%252Etxt%252Egz> .
