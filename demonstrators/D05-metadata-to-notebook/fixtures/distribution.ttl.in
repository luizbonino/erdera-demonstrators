@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# The distribution is served as its own resource, as an FDP does.

<{BASE}/distribution.ttl>
    a dcat:Distribution ;
    dct:title "Downloadable distribution of the synthetic CAKUT proteome" ;
    dct:description "CSV with one row per protein and one column per sample." ;
    dcat:mediaType "text/csv" ;
    dcat:downloadURL <{BASE}/proteome.csv> ;
    dct:license <https://w3id.org/ejp-rd/resources/licenses/v1.0/> .
